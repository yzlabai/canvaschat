# Test environment for Magic Link Authentication
# Copy this to .env.local for testing

# NextAuth Secret (required)
AUTH_SECRET="Zt3BXVudzzRq2R2WBqhwRy1dNMq48Gg9zKAYq7YwSL0="
AUTH_URL="http://localhost:3000/api/auth"
AUTH_TRUST_HOST=true

# Database (you need to set this to your actual database URL)
DATABASE_URL="your_database_url_here"

# Web URL
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_PROJECT_NAME="CanvasChat"

# Email Magic Link (for development, leave RESEND_API_KEY empty to use console logging)
# RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@canvas.chat"
NEXT_PUBLIC_AUTH_EMAIL_ENABLED="true"

# Optional OAuth providers (set to "true" to enable)
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED="false"
NEXT_PUBLIC_AUTH_GITHUB_ENABLED="false"
