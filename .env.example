# -----------------------------------------------------------------------------
# Web Information
# -----------------------------------------------------------------------------
NEXT_PUBLIC_WEB_URL = "http://localhost:3000"
NEXT_PUBLIC_PROJECT_NAME = "CanvasChat"

# -----------------------------------------------------------------------------
# Database with Supabase
# -----------------------------------------------------------------------------
# https://supabase.com/docs/guides/getting-started/quickstarts/nextjs
# Set your Supabase DATABASE_URL
DATABASE_URL = ""
NEXT_PUBLIC_SUPABASE_URL = ""
NEXT_PUBLIC_SUPABASE_ANON_KEY = ""

# -----------------------------------------------------------------------------
# Auth with next-auth
# https://authjs.dev/getting-started/installation?framework=Next.js
# Set your Auth URL and Secret
# Secret can be generated with `openssl rand -base64 32`
# -----------------------------------------------------------------------------
AUTH_SECRET = "your_auth_secret_key_here="
AUTH_URL = "http://localhost:3000/api/auth"
AUTH_TRUST_HOST = true

# Google Auth
# https://authjs.dev/getting-started/providers/google
AUTH_GOOGLE_ID = ""
AUTH_GOOGLE_SECRET = ""
NEXT_PUBLIC_AUTH_GOOGLE_ID = ""
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED = "false"
NEXT_PUBLIC_AUTH_GOOGLE_ONE_TAP_ENABLED = "false"

# Github Auth
# https://authjs.dev/getting-started/providers/github
AUTH_GITHUB_ID = ""
AUTH_GITHUB_SECRET = ""
NEXT_PUBLIC_AUTH_GITHUB_ENABLED = "false"

# Email Magic Link Auth with Resend
# https://resend.com/
RESEND_API_KEY = ""
RESEND_FROM_EMAIL = "noreply@mail.canvas.chat"
NEXT_PUBLIC_AUTH_EMAIL_ENABLED = "true"

# -----------------------------------------------------------------------------
# AI Providers Configuration
# -----------------------------------------------------------------------------

# Vercel AI Gateway (Recommended - Primary Configuration)
# https://vercel.com/docs/ai/gateway
# Get your API key from: https://vercel.com/dashboard -> AI Gateway -> API Keys
AI_GATEWAY_API_KEY = "your_vercel_ai_gateway_api_key_here"

# Optional: Custom gateway base URL (defaults to Vercel's gateway)
# AI_GATEWAY_BASE_URL = "https://ai-gateway.vercel.sh/v1/ai"

# -----------------------------------------------------------------------------
# Analytics with Google Analytics
# https://analytics.google.com
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID = ""

NEXT_PUBLIC_LOCALE_DETECTION = "false"

ADMIN_EMAILS = ""

NEXT_PUBLIC_DEFAULT_THEME = "system"


# EXA Search
EXASEARCH_API_KEY = ""

# Trigger.dev
TRIGGER_SECRET_KEY = ""
TRIGGER_API_URL = "http://localhost:8030"
TRIGGER_PROJECT = ""
NEXT_PUBLIC_TRIGGER_API_URL = "http://localhost:8030"

# Fal.ai
FAL_KEY = ""