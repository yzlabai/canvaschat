# Docker ignore file for CanvasChat
# This file specifies which files and directories should be excluded when building the Docker image

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.local
.env.development
.env.test
.env.production
.env.docker

# Next.js build output
.next/
out/
dist/

# Vercel
.vercel/

# Cloudflare
.wrangler/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# IDE and editor files
.vscode/
.idea/
.cursorrules
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Testing
coverage/
.nyc_output/

# Linting
.eslintcache

# Database
data/
debug/
*.db
*.sqlite

# Documentation
docs/
*.md
README*

# Configuration files that might contain secrets
wrangler.toml
vercel.json
trigger.config.ts

# Runtime data
logs/
*.log
*.pid
*.seed
*.pid.lock

# Temporary folders
tmp/
temp/

dev/